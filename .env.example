# ============================================
# FoodExpress Environment Variables
# ============================================
# Copy this file to .env and update the values

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=foodexpress
POSTGRES_USER=foodexpress_admin
POSTGRES_PASSWORD=your_secure_password_here

# Node.js Backend
NODE_ENV=development
BACKEND_PORT=5000

# React Frontend
FRONTEND_PORT=3000

# Database Connection String (for Node.js)
DATABASE_URL=postgresql://foodexpress_admin:your_secure_password_here@postgres:5432/foodexpress

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=*
